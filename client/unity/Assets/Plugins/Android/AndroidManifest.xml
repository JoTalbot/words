<?xml version="1.0" encoding="utf-8"?>
<!-- Custom main manifest (batch 34D), based on the Unity 6 default template.
     The only substantive change is android:networkSecurityConfig on
     <application>: the CI device smoke runs the SAME-COMMIT game server on
     the emulator host and the client reaches it over the AOSP host alias
     http://10.0.2.2:18080 (cleartext). Android 9+ blocks cleartext by
     default and run 34906844282 measured the result - UnityWebRequest threw
     "InvalidOperationException: Insecure connection not allowed" on the
     enqueue call, so the full-match leg never paired. The referenced config
     permits cleartext ONLY for the loopback-like automation hosts and keeps
     it denied everywhere else, so the production posture is unchanged. -->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.unity3d.player"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name="com.unity3d.player.UnityPlayerActivity"
                  android:theme="@style/UnityThemeSelector"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>
    </application>
</manifest>
