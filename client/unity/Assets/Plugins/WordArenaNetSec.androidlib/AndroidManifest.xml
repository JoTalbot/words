<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 34D: Android library plug-in whose ONLY job is to merge
     android:networkSecurityConfig into the final app manifest (the AGP
     merger adds application attributes from library manifests). It exists
     because Unity 6 removed Assets/Plugins/Android/res ("OBSOLETE - move
     your resources to an AAR or an Android Library", measured in run
     34910227019), so the config resource must live inside an .androidlib.
     The package attribute is required by Unity for .androidlib plug-ins
     (it becomes the generated build.gradle namespace). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jotalbot.words.netsec">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
