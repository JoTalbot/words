<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 34D. COMMITTED STATE = strict release policy: cleartext denied for
     every origin (identical to the API 28+ platform default; making it
     explicit so the shipped posture never depends on a default).
     CI device automation needs cleartext to the runner-local server over the
     AOSP host alias http://10.0.2.2, and UnityWebRequest enforces only the
     GLOBAL policy (isCleartextTrafficPermitted() without hostname - a
     domain-scoped exception was packaged and still rejected, runs
     34906844282/34912557224). Therefore BuildCommand.ApplyNetworkSecurityConfig
     REWRITES this file at build time: debug builds get
     cleartextTrafficPermitted="true" (development images only), release
     builds get exactly the strict content committed here. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
